{
	"name": "@harness/compose",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contracts": {
			"types": "./dist/contracts.d.ts",
			"default": "./dist/contracts.js"
		},
		"./fixtures": {
			"types": "./dist/fixtures.d.ts",
			"default": "./dist/fixtures.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "shx rm -rf dist",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"bin": {
		"compose-chain": "./dist/bin/compose-chain.js"
	}
}
